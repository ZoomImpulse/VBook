<Window
    x:Class="VBook.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Local Audiobook Studio">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="24,18" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="BookTitleText" FontSize="24" FontWeight="SemiBold" Text="Local Audiobook Studio" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Import and prepare a book for local narration" />
            </StackPanel>
            <Button x:Name="ImportButton" Grid.Column="1" Click="ImportButton_Click" Content="Import EPUB" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Chapters" />
                    <ListView
                        x:Name="ChapterList"
                        Grid.Row="1"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                        SelectionChanged="ChapterList_SelectionChanged"
                        SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="8,10"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Padding="28" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ChapterHeading" FontSize="20" FontWeight="SemiBold" Text="No chapter selected" />
                <TextBox
                    x:Name="ChapterEditor"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    IsEnabled="False"
                    IsSpellCheckEnabled="True"
                    PlaceholderText="Imported chapter text will appear here."
                    TextChanged="ChapterEditor_TextChanged"
                    TextWrapping="Wrap"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top" />
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Padding="20,10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Import an EPUB to begin." />
        </Border>
    </Grid>
</Window>
