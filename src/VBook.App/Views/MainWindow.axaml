<Window
    x:Class="VBook.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:books="using:VBook.Core.Books"
    xmlns:projects="using:VBook.Core.Projects"
    xmlns:vm="using:VBook.App.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding WindowTitle}"
    Width="1100"
    Height="720"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border
            Classes="panel"
            DockPanel.Dock="Bottom"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <TextBlock
                Classes="secondary"
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16"
            Margin="{DynamicResource PagePadding}">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{Binding Book.Title, FallbackValue='Local Audiobook Studio'}" />
                <TextBlock Classes="secondary" Text="Import and prepare a book for local narration" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox
                    Width="220"
                    PlaceholderText="Recent projects"
                    AutomationProperties.Name="Recent projects"
                    ItemsSource="{Binding RecentProjects}"
                    SelectedItem="{Binding SelectedRecentProject}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="projects:RecentProject">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Open" Command="{Binding OpenRecentProjectCommand}" />
                <Button Content="Save" Command="{Binding SaveProjectCommand}" HotKey="Ctrl+S" ToolTip.Tip="Save project (Ctrl+S)" />
                <Button Content="Import EPUB…" Classes="accent" Command="{Binding ImportEpubCommand}" HotKey="Ctrl+O" ToolTip.Tip="Import EPUB (Ctrl+O)" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="280,Auto,*">
            <Border Classes="panel" BorderThickness="0,1,0,0" Padding="{DynamicResource PanelPadding}">
                <DockPanel>
                    <TextBlock Classes="heading" DockPanel.Dock="Top" Margin="0,0,0,12" Text="Chapters" />
                    <ListBox
                        AutomationProperties.Name="Chapters"
                        ItemsSource="{Binding Chapters}"
                        SelectedItem="{Binding SelectedChapter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="books:ImportedChapter">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />
            <DockPanel Grid.Column="2" Margin="28">
                <TextBlock Classes="heading" DockPanel.Dock="Top" Margin="0,0,0,16" Text="{Binding ChapterHeading}" />
                <TextBox
                    AcceptsReturn="True"
                    AutomationProperties.Name="Chapter text"
                    IsEnabled="{Binding HasChapter}"
                    PlaceholderText="Imported chapter text will appear here."
                    Text="{Binding ChapterText}"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
