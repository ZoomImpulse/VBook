<Window
    x:Class="VBook.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:books="using:VBook.Core.Books"
    xmlns:projects="using:VBook.Core.Projects"
    xmlns:vm="using:VBook.App.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding WindowTitle}"
    Width="1100"
    Height="720"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border
            Classes="panel"
            DockPanel.Dock="Bottom"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <TextBlock
                Classes="secondary"
                AutomationProperties.LiveSetting="Polite"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="16"
            Margin="{DynamicResource PagePadding}">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{Binding Book.Title, FallbackValue='Local Audiobook Studio'}" />
                <TextBlock Classes="secondary" Text="Import and prepare a book for local narration" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox
                    Width="220"
                    PlaceholderText="Recent projects"
                    AutomationProperties.Name="Recent projects"
                    ItemsSource="{Binding RecentProjects}"
                    SelectedItem="{Binding SelectedRecentProject}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="projects:RecentProject">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Open" Command="{Binding OpenRecentProjectCommand}" />
                <Button Content="Save" Command="{Binding SaveProjectCommand}" HotKey="Ctrl+S" ToolTip.Tip="Save project (Ctrl+S)" />
                <Button Content="Import EPUB…" Classes="accent" Command="{Binding ImportEpubCommand}" HotKey="Ctrl+O" ToolTip.Tip="Import EPUB (Ctrl+O)" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="280,Auto,*">
            <Border Classes="panel" BorderThickness="0,1,0,0" Padding="{DynamicResource PanelPadding}">
                <DockPanel>
                    <TextBlock Classes="heading" DockPanel.Dock="Top" Margin="0,0,0,12" Text="Chapters" />
                    <ListBox
                        AutomationProperties.Name="Chapters"
                        ItemsSource="{Binding Chapters}"
                        SelectedItem="{Binding SelectedChapter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="books:ImportedChapter">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />
            <DockPanel Grid.Column="2" Margin="28">
                <TextBlock Classes="heading" DockPanel.Dock="Top" Margin="0,0,0,12" Text="{Binding ChapterHeading}" />
                <TabControl>
                    <TabItem Header="Text">
                        <TextBox
                            Margin="0,12,0,0"
                            AcceptsReturn="True"
                            AutomationProperties.Name="Chapter text"
                            IsEnabled="{Binding HasChapter}"
                            PlaceholderText="Imported chapter text will appear here."
                            Text="{Binding ChapterText}"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top" />
                    </TabItem>
                    <TabItem Header="Narrative">
                        <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Classes="accent"
                                    Content="Analyze chapter"
                                    Command="{Binding AnalyzeChapterCommand}" />
                                <Button
                                    Content="Cancel"
                                    Command="{Binding AnalyzeChapterCancelCommand}"
                                    IsVisible="{Binding IsAnalyzing}" />
                                <TextBlock
                                    Classes="secondary"
                                    VerticalAlignment="Center"
                                    Text="{Binding AnalyzerName, StringFormat='Analyzer: {0}'}" />
                                <CheckBox
                                    Content="Multiple voices (dialogue cast)"
                                    IsChecked="{Binding UseMultipleVoices}"
                                    ToolTip.Tip="Off: one narrator reads the whole book. Best for non-fiction, textbooks, memoir and essays. On: dialogue is attributed to characters." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="4" Margin="0,12">
                                <ProgressBar
                                    Maximum="1"
                                    AutomationProperties.Name="Analysis progress"
                                    IsVisible="{Binding IsAnalyzing}"
                                    Value="{Binding AnalysisProgress}" />
                                <TextBlock
                                    Classes="secondary"
                                    AutomationProperties.LiveSetting="Polite"
                                    Text="{Binding AnalysisStatus}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    IsVisible="{Binding IsAnalysisStale}"
                                    Text="The chapter text changed since the last analysis. Analyze again to refresh the segments."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="220,Auto,*">
                                <DockPanel>
                                    <TextBlock Classes="heading" DockPanel.Dock="Top" Margin="0,0,0,8" Text="Characters" />
                                    <ListBox AutomationProperties.Name="Characters" ItemsSource="{Binding Characters}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CharacterItem">
                                                <StackPanel Margin="0,2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="secondary" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />
                                <DockPanel Grid.Column="2">
                                    <TextBlock Classes="heading" DockPanel.Dock="Top" Margin="8,0,0,8" Text="Segments" />
                                    <ListBox AutomationProperties.Name="Segments" ItemsSource="{Binding Segments}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SegmentItem">
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Classes="secondary" FontWeight="SemiBold" Text="{Binding Speaker}" />
                                                    <TextBlock
                                                        Classes.narration="{Binding IsNarration}"
                                                        Text="{Binding Text}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
